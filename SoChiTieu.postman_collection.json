{
  "info": {
    "name": "Sổ Chi Tiêu API",
    "description": "Các request cho backend Sổ Chi Tiêu Du Học. Chạy 'Đăng nhập' (hoặc 'Đăng ký') trước, token sẽ tự lưu vào biến {{token}} và mọi request khác tự dùng nó.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "month",
      "value": "2026-11"
    },
    {
      "key": "txId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Tài khoản",
      "item": [
        {
          "name": "Đăng ký",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('token', pm.response.json().token);",
                  "  console.log('Đã lưu token');",
                  "}",
                  "pm.test('Đăng ký thành công (201)', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"phong@example.com\",\n  \"password\": \"matkhau123\",\n  \"displayName\": \"Phong\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Đăng nhập",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('token', pm.response.json().token);",
                  "  console.log('Đã lưu token');",
                  "}",
                  "pm.test('Đăng nhập thành công (200)', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"phong@example.com\",\n  \"password\": \"matkhau123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Thông tin tài khoản",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me"
              ]
            }
          }
        },
        {
          "name": "Đặt ngân sách tháng",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/me/budget",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me",
                "budget"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{ \"monthlyBudget\": 1000000 }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Đặt mục tiêu thu nhập tháng",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/me/goal",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me",
                "goal"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{ \"monthlyIncomeGoal\": 2500000 }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "2. Khoản thu chi",
      "item": [
        {
          "name": "Danh sách trong tháng",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/transactions?month={{month}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions"
              ],
              "query": [
                {
                  "key": "month",
                  "value": "{{month}}"
                }
              ]
            }
          }
        },
        {
          "name": "Thêm khoản chi",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('txId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"EXPENSE\",\n  \"amount\": 9500,\n  \"category\": \"Ăn uống\",\n  \"date\": \"2026-11-12\",\n  \"memo\": \"Cơm căng tin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Thêm khoản thu (có chi phí đi kèm)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"INCOME\",\n  \"amount\": 128000,\n  \"cost\": 9000,\n  \"category\": \"Chạy xe / giao hàng\",\n  \"date\": \"2026-11-12\",\n  \"memo\": \"Chạy xe\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Sửa khoản",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/{{txId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions",
                "{{txId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"EXPENSE\",\n  \"amount\": 12000,\n  \"category\": \"Ăn uống\",\n  \"date\": \"2026-11-12\",\n  \"memo\": \"Cơm + nước\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Xóa khoản",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/transactions/{{txId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions",
                "{{txId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Tổng kết",
      "item": [
        {
          "name": "Tổng kết tháng",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/summary?month={{month}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "summary"
              ],
              "query": [
                {
                  "key": "month",
                  "value": "{{month}}"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}